{
  "schema": 1,
  "profile": "home-shell-with-analytics-declined",
  "persona": "anonymous-product-reader",
  "package": "org.openpetfoodfacts.scanner.debug",
  "timeout_seconds": 300.0,
  "allowed_foreign_packages": [],
  "secret_environment": {},
  "steps": [
    {
      "id": "wait-for-welcome-skip",
      "kind": "wait_for",
      "required": true,
      "timeout_seconds": 60.0,
      "parameters": {"predicate": {"kind": "node_present", "timeout_seconds": 60.0, "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/btn_skip", "text": "SKIP"}}}}
    },
    {
      "id": "skip-welcome",
      "kind": "tap",
      "required": true,
      "timeout_seconds": 30.0,
      "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/btn_skip", "text": "SKIP"}}
    },
    {
      "id": "wait-for-analytics-decline",
      "kind": "wait_for",
      "required": true,
      "timeout_seconds": 60.0,
      "parameters": {"predicate": {"kind": "node_present", "timeout_seconds": 60.0, "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/btn_skip", "text": "DECLINE"}}}}
    },
    {
      "id": "decline-anonymous-analytics",
      "kind": "tap",
      "required": true,
      "timeout_seconds": 30.0,
      "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/btn_skip", "text": "DECLINE"}}
    },
    {
      "id": "restart-after-onboarding",
      "kind": "restart_preserving_state",
      "required": true,
      "timeout_seconds": 90.0,
      "parameters": {}
    },
    {
      "id": "wait-for-home-tagline-witness",
      "kind": "wait_for",
      "required": true,
      "timeout_seconds": 90.0,
      "parameters": {"predicate": {"kind": "node_present", "timeout_seconds": 90.0, "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/taglineHome", "text": "free pet food products database"}}}}
    }
  ],
  "success_predicates": [
    {"kind": "package_foreground", "timeout_seconds": 30.0, "parameters": {"package": "org.openpetfoodfacts.scanner.debug"}},
    {"kind": "activity_resumed", "timeout_seconds": 30.0, "parameters": {"component": "org.openpetfoodfacts.scanner.debug/openfoodfacts.github.scrachx.openfood.features.MainActivity"}},
    {"kind": "node_present", "timeout_seconds": 30.0, "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/taglineHome", "text": "free pet food products database"}}},
    {"kind": "node_absent", "timeout_seconds": 10.0, "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/btn_skip", "text": "SKIP"}}},
    {"kind": "node_absent", "timeout_seconds": 10.0, "parameters": {"selector": {"package": "org.openpetfoodfacts.scanner.debug", "resource_id": "org.openpetfoodfacts.scanner.debug:id/btn_skip", "text": "DECLINE"}}}
  ]
}

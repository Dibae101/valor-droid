  ],
  "success_predicates": [
    {
      "kind": "package_foreground",
      "timeout_seconds": 30.0,
      "parameters": {"package": "org.moire.ultrasonic.debug"}
    },
    {
      "kind": "activity_resumed",
      "timeout_seconds": 30.0,
      "parameters": {
        "component": "org.moire.ultrasonic.debug/org.moire.ultrasonic.activity.NavigationActivity"
      }
    },
    {
      "kind": "node_present",
      "timeout_seconds": 60.0,
      "parameters": {
        "selector": {
          "package": "org.moire.ultrasonic.debug",
          "resource_id": "org.moire.ultrasonic.debug:id/current_playing_song",
          "text": "VALOR Navidrome Fixture Track"
        }
      }
    },
    {
      "kind": "node_present",
      "timeout_seconds": 60.0,
      "parameters": {
        "selector": {
          "package": "org.moire.ultrasonic.debug",
          "resource_id": "org.moire.ultrasonic.debug:id/current_playing_album",
          "text": "VALOR Navidrome Fixture Album"
        }
      }
    },
    {
      "kind": "node_absent",
      "timeout_seconds": 10.0,
      "parameters": {
        "selector": {
          "package": "org.moire.ultrasonic.debug",
          "resource_id": "android:id/button2",
          "text": "TAKE ME TO THE SETTINGS"
        }
      }
    }
  ]

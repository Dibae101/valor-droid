# Copy to .env (never commit real values). Only needed for LLM-backed runs.
# Any OpenAI-compatible endpoint works; Pollinations.ai needs no key.
OPENAI_BASE_URL=https://text.pollinations.ai/openai
OPENAI_API_KEY=
LLM_MODEL=openai
# TypeSafe Jev decision engine (recovery rung selection). Optional.
TYPESAFE_JEV=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.dev
